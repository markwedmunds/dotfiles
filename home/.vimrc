syntax on
set termguicolors                     " true color, matches wezterm/nvim
set background=dark
let g:gruvbox_contrast_dark = 'hard'   " gruvbox dark, hard - same as wezterm/nvim
let g:gruvbox_italic = 1
colorscheme gruvbox
highlight Comment cterm=italic gui=italic
set number
set noswapfile
set hlsearch
set ignorecase
set incsearch
